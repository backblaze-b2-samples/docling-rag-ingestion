# Backblaze B2 (required)
# Standardized B2_* names — the S3-compatible API is the only surface this app uses.
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name

# Region your bucket lives in. The S3 endpoint is derived from this as
# https://s3.<region>.backblazeb2.com — there is no separate endpoint var.
# Defaults to us-west-004 if omitted, so this line is optional.
B2_REGION=us-west-004

# Optional. Public base URL for building object links when the bucket is public
# (e.g. https://<bucket>.s3.us-west-004.backblazeb2.com). Leave empty for a
# private bucket — the app works without it and uses presigned URLs instead.
# B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=005EXAMPLE_NOT_A_REAL_KEY_ID
# B2_APPLICATION_KEY=your-application-key-shown-once
# B2_BUCKET_NAME=my-app-uploads
# B2_REGION=us-west-004

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
